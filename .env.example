# ============================================================================
# Databricks Environment Variables (OPTIONAL)
# ============================================================================
#
# This file is OPTIONAL. You can set these variables in your shell instead.
#
# However, if you prefer project-specific configuration, you can:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your values
# 3. Source it before starting Claude: source .env && claude
#
# ============================================================================

# ----------------------------------------------------------------------------
# MCP Server Configuration (Required for DBSQL queries)
# ----------------------------------------------------------------------------
# These enable Claude to query your data directly via DBSQL MCP server
# Set these BEFORE starting Claude Code for MCP to work

export DATABRICKS_WORKSPACE_URL=https://your-workspace.cloud.databricks.com
export DATABRICKS_TOKEN=dapi...your-token-here

# How to get these values:
# - Workspace URL: Your Databricks workspace URL (check browser when logged in)
# - Token: User Settings → Developer → Access Tokens → Generate New Token

# ----------------------------------------------------------------------------
# Databricks Connect Configuration (Optional)
# ----------------------------------------------------------------------------
# These configure how Databricks Connect runs your code remotely
# If not set, Databricks Connect will use defaults from ~/.databrickscfg

# Option 1: Use profile + serverless (recommended)
# export DATABRICKS_CONFIG_PROFILE=DEFAULT
# export DATABRICKS_SERVERLESS_COMPUTE_ID=auto

# Option 2: Use profile + specific cluster
# export DATABRICKS_CONFIG_PROFILE=DEFAULT
# export DATABRICKS_CLUSTER_ID=your-cluster-id

# ============================================================================
# Usage
# ============================================================================
#
# If using this file:
#   source .env        # Load environment variables
#   claude             # Start Claude Code
#
# Or set variables directly in your terminal:
#   export DATABRICKS_WORKSPACE_URL=https://...
#   export DATABRICKS_TOKEN=dapi...
#   claude
#
# ============================================================================
